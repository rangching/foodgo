# 只有埠號被占用時才需要：cp .env.example .env，再改下面的數字。
# docker compose 會自己讀 .env；Python 程式要加 --env-file，例如 uv run --env-file .env fastapi dev
FOODGO_POSTGRES_PORT=15432
FOODGO_KAFKA_PORT=19092
FOODGO_KAFKA_UI_PORT=18080
# 第 10 集：Jaeger 的 UI 與收 span 的入口（OTLP／HTTP）
FOODGO_JAEGER_UI_PORT=16686
FOODGO_OTLP_PORT=14318
# 第 10 集：五個程序在本機的埠（Python 程式讀）。要改再拿掉 # 號
# 第 11 集：FOODGO_GATEWAY_PORT 也是 Gateway 容器對外的埠（容器裡一律聽 8000）
# FOODGO_GATEWAY_PORT=8000
# FOODGO_ORDERING_PORT=8101
# FOODGO_PAYMENT_PORT=8102
# FOODGO_KITCHEN_PORT=8103
# FOODGO_DELIVERY_PORT=8104
# 第 11 集：想讓 docker compose 每次都連 FoodGo 的五個容器一起管（不用每次打 --profile app），拿掉 # 號
# COMPOSE_PROFILES=app
