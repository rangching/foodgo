[importlinter]
root_package = foodgo

[importlinter:contract:contexts]
name = 四個上下文彼此獨立
type = independence
modules =
    foodgo.ordering
    foodgo.payment
    foodgo.kitchen
    foodgo.delivery

[importlinter:contract:shared]
name = 共用核心不認識任何上下文
type = forbidden
source_modules =
    foodgo.shared
forbidden_modules =
    foodgo.ordering
    foodgo.payment
    foodgo.kitchen
    foodgo.delivery

[importlinter:contract:app]
name = 上下文不認識組裝點
type = forbidden
source_modules =
    foodgo.shared
    foodgo.ordering
    foodgo.payment
    foodgo.kitchen
    foodgo.delivery
forbidden_modules =
    foodgo.app

[importlinter:contract:contracts]
name = 共同語言不認識任何上下文
type = forbidden
source_modules =
    foodgo.contracts
forbidden_modules =
    foodgo.ordering
    foodgo.payment
    foodgo.kitchen
    foodgo.delivery
    foodgo.shared
    foodgo.app

[importlinter:contract:infra]
name = 基礎設施不認識任何上下文
type = forbidden
source_modules =
    foodgo.infra
forbidden_modules =
    foodgo.ordering
    foodgo.payment
    foodgo.kitchen
    foodgo.delivery
    foodgo.contracts
    foodgo.shared
    foodgo.app
