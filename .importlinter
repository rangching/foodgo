[importlinter]
root_package = foodgo

[importlinter:contract:contexts]
name = 四個上下文彼此獨立
type = independence
modules =
    foodgo.ordering
    foodgo.payment
    foodgo.kitchen
    foodgo.delivery

[importlinter:contract:shared]
name = 共用核心不認識任何上下文
type = forbidden
source_modules =
    foodgo.shared
forbidden_modules =
    foodgo.ordering
    foodgo.payment
    foodgo.kitchen
    foodgo.delivery

[importlinter:contract:app]
name = 上下文不認識組裝點
type = forbidden
source_modules =
    foodgo.shared
    foodgo.ordering
    foodgo.payment
    foodgo.kitchen
    foodgo.delivery
forbidden_modules =
    foodgo.app

[importlinter:contract:contracts]
name = 共同語言不認識任何上下文
type = forbidden
source_modules =
    foodgo.contracts
forbidden_modules =
    foodgo.ordering
    foodgo.payment
    foodgo.kitchen
    foodgo.delivery
    foodgo.shared
    foodgo.app

[importlinter:contract:infra]
name = 基礎設施不認識任何上下文
type = forbidden
source_modules =
    foodgo.infra
forbidden_modules =
    foodgo.ordering
    foodgo.payment
    foodgo.kitchen
    foodgo.delivery
    foodgo.contracts
    foodgo.shared
    foodgo.app

[importlinter:contract:domain]
name = 點餐的領域模型不碰基礎設施
type = forbidden
source_modules =
    foodgo.ordering.model
    foodgo.ordering.events
    foodgo.ordering.fold
    foodgo.ordering.codec
forbidden_modules =
    foodgo.infra
    foodgo.contracts

[importlinter:contract:acl]
name = 付款只透過防腐層找金流服務
type = forbidden
source_modules =
    foodgo.payment.payment
    foodgo.payment.repository
    foodgo.payment.postgres
    foodgo.payment.service
    foodgo.payment.consumer
forbidden_modules =
    foodgo.payment.fakepay
allow_indirect_imports = True

[importlinter:contract:saga]
name = 編排器只透過共同語言指揮
type = forbidden
source_modules =
    foodgo.saga
forbidden_modules =
    foodgo.ordering
    foodgo.payment
    foodgo.kitchen
    foodgo.delivery
    foodgo.shared
    foodgo.app

[importlinter:contract:participants]
name = 參與者不知道誰在指揮
type = forbidden
source_modules =
    foodgo.ordering
    foodgo.payment
    foodgo.kitchen
    foodgo.delivery
    foodgo.shared
    foodgo.contracts
    foodgo.infra
forbidden_modules =
    foodgo.saga

[importlinter:contract:tracking]
name = 讀模型只吃共同語言
type = forbidden
source_modules =
    foodgo.tracking
forbidden_modules =
    foodgo.ordering
    foodgo.payment
    foodgo.kitchen
    foodgo.delivery
    foodgo.shared
    foodgo.saga
    foodgo.app

[importlinter:contract:writers]
name = 寫入端不知道誰在讀
type = forbidden
source_modules =
    foodgo.ordering
    foodgo.payment
    foodgo.kitchen
    foodgo.delivery
    foodgo.shared
    foodgo.contracts
    foodgo.infra
    foodgo.saga
forbidden_modules =
    foodgo.tracking
